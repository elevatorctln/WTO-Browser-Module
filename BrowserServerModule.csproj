<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>BrowserServerModule</RootNamespace>
		<AssemblyName>BrowserServerModule</AssemblyName>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Version>1.1.0</Version>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<ItemGroup>
		<None Update="mod.toml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<!-- Web assets for the OBS browser source overlay -->
		<None Include="web\**\*" Link="web\%(RecursiveDir)%(Filename)%(Extension)">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<!-- Mod rules require the full licence text in the download itself. -->
		<None Update="LICENSE.TXT">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup Condition="Exists('..\KSATelemetryOverlay\KSATelemetryOverlay.csproj')">
		<ProjectReference Include="..\KSATelemetryOverlay\KSATelemetryOverlay.csproj">
			<Private>false</Private>
		</ProjectReference>
	</ItemGroup>
	<ItemGroup Condition="!Exists('..\KSATelemetryOverlay\KSATelemetryOverlay.csproj') and Exists('$(ImportDir)KSATelemetryOverlay.dll')">
		<Reference Include="$(ImportDir)KSATelemetryOverlay.dll">
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<PropertyGroup>
		<ImportDir Condition="'$(ImportDir)' == ''">$(MSBuildThisFileDirectory)..\Import\</ImportDir>
		<ImportDir Condition="!Exists('$(ImportDir)')">$(MSBuildThisFileDirectory)..\..\Import\</ImportDir>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="$(ImportDir)KSA.dll">
			<Private>false</Private>
		</Reference>
		<Reference Include="$(ImportDir)Brutal.ImGui.dll">
			<Private>false</Private>
		</Reference>
		<Reference Include="$(ImportDir)Brutal.ImGui.Extensions.dll">
			<Private>false</Private>
		</Reference>
		<Reference Include="$(ImportDir)Brutal.ImGui.Abstractions.dll">
			<Private>false</Private>
		</Reference>
		<Reference Include="$(ImportDir)Brutal.Numerics.dll">
			<Private>false</Private>
		</Reference>
		<Reference Include="$(ImportDir)Brutal.Strings.dll">
			<Private>false</Private>
		</Reference>
		<Reference Include="$(ImportDir)Brutal.Core.dll">
			<Private>false</Private>
		</Reference>
		<Reference Include="$(ImportDir)Brutal.Collections.dll">
			<Private>false</Private>
		</Reference>
		<Reference Include="$(ImportDir)Brutal.Maths.dll">
			<Private>false</Private>
		</Reference>
		<Reference Include="$(ImportDir)Brutal.Memory.dll">
			<Private>false</Private>
		</Reference>
		<Reference Include="$(ImportDir)Brutal.Logging.dll">
			<Private>false</Private>
		</Reference>
		<Reference Include="$(ImportDir)StarMap.API.dll">
			<Private>false</Private>
		</Reference>
		<Reference Include="$(ImportDir)0Harmony.dll">
			<Private>false</Private>
		</Reference>
		<Reference Include="$(ImportDir)Brutal.Vulkan.dll">
			<Private>false</Private>
		</Reference>
		<Reference Include="$(ImportDir)Brutal.Vulkan.Abstractions.dll">
			<Private>false</Private>
		</Reference>
		<Reference Include="$(ImportDir)Planet.Render.Core.dll">
			<Private>false</Private>
		</Reference>
	</ItemGroup>

</Project>
